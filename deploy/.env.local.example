# Optional. Copy to deploy/.env.local (gitignored) and pass:
#   docker compose --env-file deploy/.env.local -f deploy/docker-compose.local.yml up --build
#
# Defaults in docker-compose.local.yml match the dashboard in
# frontend/applyvault-jobs-ui/src/environments/environment.ts.

MSSQL_SA_PASSWORD=ApplyVault_local_1
SUPABASE_URL=https://riglrazbjbucpyhaofvb.supabase.co

# Gemini API key from https://aistudio.google.com/apikey
# Set GOOGLE_AI_ENABLED=true only after GOOGLE_AI_API_KEY is filled.
GOOGLE_AI_ENABLED=false
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash

# OAuth Web client from Google Cloud Console (Calendar + Gmail share one client).
# Set GMAIL_ENABLED=true only after both values are filled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_ENABLED=false

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL must be http://localhost:5173/api/github-connections/github/callback
# Set GITHUB_ENABLED=true only after both values are filled.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_ENABLED=false
