{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thearchitect.local/schemas/project-context.schema.json",
  "title": "SharedProjectContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "capabilities", "technology", "contracts", "constraints"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "description", "business_goal", "phase"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["GREENFIELD", "BROWNFIELD", "HYBRID"]
        },
        "description": { "type": "string" },
        "business_goal": { "type": "string" },
        "phase": {
          "type": "string",
          "enum": ["DISCOVERY", "DESIGN", "IMPLEMENTATION", "VALIDATION", "RELEASE"]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "type": "string" },
        "approval_required_for": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "existing_operating_procedures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detection_status": {
          "type": "string",
          "enum": ["FOUND", "PARTIAL", "NOT_FOUND"]
        },
        "adaptation_mode": {
          "type": "string",
          "enum": ["FOLLOW", "COMPOSE", "BRIDGE", "NONE"]
        },
        "procedure_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canonical_workflow_chain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domain_memory_locations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "work_tracking_binding": { "type": "string" },
        "precedence_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capabilityEntry"
      },
      "properties": {
        "identity": { "$ref": "#/$defs/capabilityEntry" },
        "payments": { "$ref": "#/$defs/capabilityEntry" },
        "ai": { "$ref": "#/$defs/capabilityEntry" },
        "persistence": { "$ref": "#/$defs/capabilityEntry" },
        "hosting": { "$ref": "#/$defs/capabilityEntry" },
        "cicd": { "$ref": "#/$defs/capabilityEntry" },
        "observability": { "$ref": "#/$defs/capabilityEntry" }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "mobile": { "type": "string" },
        "database": { "type": "string" },
        "infrastructure_as_code": { "type": "string" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "type": "string" },
        "events": { "type": "string" },
        "data": { "type": "string" },
        "identity": { "type": "string" },
        "authorization": { "type": "string" },
        "billing": { "type": "string" },
        "ai": { "type": "string" },
        "configuration": { "type": "string" },
        "observability": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "security": { "type": "array", "items": { "type": "string" } },
        "compliance": { "type": "array", "items": { "type": "string" } },
        "availability": { "type": "string" },
        "latency": { "type": "string" },
        "scalability": { "type": "string" },
        "budget": { "type": "string" },
        "data_residency": { "type": "string" },
        "delivery": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified": { "type": "array", "items": { "type": "string" } },
        "user_reported": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "array", "items": { "type": "string" } },
        "proposed": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "provider", "status"],
      "properties": {
        "required": {
          "type": "string",
          "enum": ["YES", "NO", "UNDECIDED"]
        },
        "provider": { "type": "string" },
        "status": {
          "$ref": "https://thearchitect.local/schemas/capability-matrix.schema.json#/$defs/providerDecisionState"
        }
      }
    }
  }
}
